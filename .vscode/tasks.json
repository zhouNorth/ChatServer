{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Linux chat programs",
            "type": "process",
            "command": "bash",
            "args": ["${workspaceFolder}/scripts/build-linux.sh"],
            "windows": {
                "command": "wsl.exe",
                "args": ["-d", "Ubuntu", "--", "bash", "scripts/build-linux.sh"]
            },
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}
